{
	"name": "basic",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build --mode client && vite build",
		"preview": "wrangler pages dev",
		"deploy": "$npm_execpath run build && wrangler pages deploy",
		"create:entry": "bun createEntry.ts",
		"lint:text": "textlint \"**/*.mdx\" -f pretty-error",
		"format": "biome format --write",
		"check": "biome check --write"
	},
	"private": true,
	"dependencies": {
		"@hono/vite-ssg": "0.1.0",
		"@mdx-js/rollup": "3.1.1",
		"@resvg/resvg-js": "2.6.2",
		"budoux": "0.9.2",
		"hono": "4.13.8",
		"honox": "0.1.61",
		"jsdom": "30.1.1",
		"rehype-highlight": "7.0.2",
		"rehype-pretty-code": "0.14.5",
		"rehype-stringify": "10.0.1",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"remark-mdx-frontmatter": "6.0.0",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"satori": "0.33.5",
		"shiki": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/workers-types": "5.20260923.1",
		"@hono/vite-build": "1.11.1",
		"@hono/vite-dev-server": "0.26.1",
		"@textlint/textlint-plugin-markdown": "15.8.0",
		"@types/bun": "1.4.2",
		"@types/jsdom": "30.0.0",
		"autoprefixer": "10.6.1",
		"postcss": "8.5.28",
		"prompts": "2.4.2",
		"tailwindcss": "3.4.17",
		"textlint": "15.8.0",
		"vite": "8.3.0",
		"vite-plugin-static-copy": "4.1.1",
		"wrangler": "4.136.3"
	},
	"module": "index.ts",
	"peerDependencies": {
		"typescript": "5.9.2"
	}
}
